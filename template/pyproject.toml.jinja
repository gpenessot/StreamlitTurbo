[project]
name = "{{ project_slug }}"
version = "1.0.0"
description = "{{ project_description }}"
readme = "README.md"
requires-python = ">={{ python_version }}"
authors = [
    { name = "{{ author_name }}", email = "{{ author_email }}" }
]

dependencies = [
    # 1.50+ requis : st.navigation(position="top"), [[theme.fontFaces]],
    # [theme.sidebar] et chartCategoricalColors utilises par ce template.
    "streamlit>=1.50.0",
    "pandas>=2.0.0",
    "numpy>=1.24.0",
    "plotly>=5.15.0",
    "altair>=5.0.0",
    "python-dotenv>=1.0.0",
]

# Groupe installe automatiquement par `uv sync` (PEP 735).
[dependency-groups]
dev = [
    "pytest>=7.4.0",
    "ruff>=0.6.0",
    "mypy>=1.7.0",
]

[tool.ruff]
line-length = 100
target-version = "py{{ python_version | replace('.', '') }}"

[tool.ruff.lint]
select = ["E", "F", "I", "N", "W"]
ignore = []

[tool.ruff.lint.per-file-ignores]
# Streamlit impose un prefixe numerique sur les fichiers de pages.
"src/*/pages/*.py" = ["N999"]

[tool.mypy]
python_version = "{{ python_version }}"
warn_return_any = true
warn_unused_configs = true
disallow_untyped_defs = false

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["src"]
python_files = ["test_*.py"]
python_classes = ["Test*"]
python_functions = ["test_*"]
