"""
Page Paramètres - Configuration de l'application
"""

import streamlit as st

from {{ project_slug | replace('-', '_') }}.components.footer import render_footer


def main():
    """Page de paramètres."""

    st.title(":material/settings: Paramètres")

    # Thème actuel
    current_theme = st.get_option("theme.base")
    st.info(f":material/palette: Thème actuel : **{current_theme}**")

    st.markdown("---")

    # Tabs pour organiser les paramètres
    tab1, tab2, tab3 = st.tabs(
        [
            ":material/person: Profil",
            ":material/display_settings: Affichage",
            ":material/info: À propos",
        ]
    )

    with tab1:
        st.subheader("Informations du profil")

        col1, col2 = st.columns(2)

        with col1:
            st.text_input(
                "Nom d'utilisateur",
                value="{{ author_name }}",
                key="user_name",
                help="Votre nom d'affichage",
            )

            st.text_input(
                "Email",
                value="{{ author_email }}",
                key="user_email",
                help="Votre adresse email",
            )

        with col2:
            st.markdown("#### Statistiques")
            st.metric("Sessions", "42")
            st.metric("Dernier accès", "Aujourd'hui")

        if st.button(":material/save: Sauvegarder le profil", type="primary"):
            st.success(
                f"Profil sauvegardé : {st.session_state.user_name} ({st.session_state.user_email})"
            )

    with tab2:
        st.subheader("Préférences d'affichage")

        st.info("""
        **Note :** Le thème (dark/light/blue/green) est configuré dans `.streamlit/config.toml`

        Pour changer de thème, modifiez la variable `streamlit_theme` lors de la
        generation du template avec Copier.
        """)

        col1, col2 = st.columns(2)

        with col1:
            st.selectbox("Largeur de page", ["Centrée", "Large"], index=1, key="layout")

            st.checkbox(
                "Afficher la sidebar",
                value=False,
                key="show_sidebar",
                help="Navigation top par défaut",
            )

        with col2:
            st.slider(
                "Vitesse des animations",
                min_value=0,
                max_value=100,
                value=50,
                key="animation_speed",
                help="0 = désactivées, 100 = rapides",
            )

        st.caption(
            "Ces préférences sont stockées dans `st.session_state` "
            "et persistent pendant la session."
        )

    with tab3:
        st.subheader("À propos de l'application")

        st.markdown("""
        ### {{ project_name }}

        **Description:** {{ project_description }}

        **Version:** 1.0.0

        **Auteur:** {{ author_name }}

        **Email:** {{ author_email }}

        **Python:** {{ python_version }}+

        **Streamlit:** >= 1.50.0

        ---

        ### Technologies utilisées

        - :material/language: **Streamlit** - Framework d'application
        - :material/storage: **Pandas** - Manipulation de données
        - :material/insert_chart: **Plotly** - Visualisations interactives
        - :material/science: **NumPy** - Calculs numériques

        ---

        ### Support

        Pour toute question ou problème, contactez : {{ author_email }}
        """)

    # Footer en fin de page
    render_footer()


if __name__ == "__main__":
    main()
