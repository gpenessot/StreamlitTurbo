"""
Composant Sidebar - Panneau latéral optionnel

L'application utilise la navigation top (voir main.py) et la sidebar est
repliée par défaut. Ce composant est fourni si vous souhaitez l'utiliser :
appelez `render_sidebar()` au début d'une page, et passez
`initial_sidebar_state="expanded"` dans `st.set_page_config`.
"""

from datetime import datetime

import streamlit as st


def render_sidebar():
    """Affiche la sidebar avec les informations de session."""

    with st.sidebar:
        st.markdown("### :material/rocket_launch: {{ project_name }}")
        st.markdown("---")

        st.markdown("#### :material/schedule: Session")

        if "session_start" not in st.session_state:
            st.session_state.session_start = datetime.now()

        elapsed = datetime.now() - st.session_state.session_start
        minutes, seconds = divmod(int(elapsed.total_seconds()), 60)

        user = st.session_state.get("user_name", "{{ author_name }}")
        st.caption(f":material/person: {user}")
        st.caption(f":material/timer: {minutes}m {seconds}s")
        st.caption(f":material/calendar_today: {datetime.now().strftime('%d/%m/%Y %H:%M')}")

        st.markdown("---")

        if st.button(
            ":material/refresh: Actualiser",
            width="stretch",
            help="Relance le script et vide le cache",
        ):
            st.cache_data.clear()
            st.rerun()

        with st.expander(":material/help: Aide & Support"):
            st.markdown(
                "- Documentation : [docs.streamlit.io](https://docs.streamlit.io)\n"
                "- Contact : {{ author_email }}\n\n"
                "**Envie d'aller plus loin ?**\n\n"
                "[Streamlit Unleashed]"
                "(https://www.mes-formations-data.fr/formation/streamlit-unleashed)"
            )
